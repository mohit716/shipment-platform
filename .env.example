# Copy to .env and adjust. The real .env is never committed.
#   cp .env.example .env

APP_NAME=FleetLine
ENVIRONMENT=development
DEBUG=true

# Matches the db service in docker-compose.yml. Port 5433 avoids colliding with
# a PostgreSQL already installed on the host.
DATABASE_URL=postgresql+asyncpg://fleetline:fleetline@localhost:5433/fleetline

# Print every SQL statement. Useful while learning, far too noisy in production.
DATABASE_ECHO=true

# Signs access tokens. Generate a real one per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Anyone who knows this value can mint a token for any account.
SECRET_KEY=dev-only-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# bcrypt work factor. Each step doubles hashing time. Raise it as hardware
# improves; never lower it below 12 in production.
BCRYPT_ROUNDS=12

# console logs messages instead of sending them. Switch to smtp and fill in the
# relay details to send for real.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@fleetline.example
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# Where emailed links point; the dashboard serves those pages, not the API.
FRONTEND_URL=http://localhost:5173
VERIFICATION_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=15

# Adds an SMS channel alongside email.
SMS_ENABLED=false

# Matches the redis service in docker-compose.yml. Database 0 carries the queue
# and 1 the results, so flushing one does not destroy the other.
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1
