# Copy to .env and adjust. The real .env is never committed.
#   cp .env.example .env

APP_NAME=FleetLine
ENVIRONMENT=development
DEBUG=true

# Matches the db service in docker-compose.yml. Port 5433 avoids colliding with
# a PostgreSQL already installed on the host.
DATABASE_URL=postgresql+asyncpg://fleetline:fleetline@localhost:5433/fleetline

# Print every SQL statement. Useful while learning, far too noisy in production.
DATABASE_ECHO=true

# Signs access tokens. Generate a real one per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Anyone who knows this value can mint a token for any account.
SECRET_KEY=dev-only-secret-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# bcrypt work factor. Each step doubles hashing time. Raise it as hardware
# improves; never lower it below 12 in production.
BCRYPT_ROUNDS=12
